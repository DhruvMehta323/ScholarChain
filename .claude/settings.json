{
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git rev-parse*)",
      "Bash(ls*)",
      "Bash(pwd)",
      "Bash(sbt check)",
      "Bash(sbt test*)",
      "Bash(sbt compile*)",
      "Bash(sbt scalafmtCheckAll)",
      "Bash(bash -n *)",
      "Bash(shellcheck *)",
      "Bash(python3 -m json.tool *)",
      "Bash(terraform fmt -check*)",
      "Bash(terraform validate*)",
      "Bash(.claude/hooks/validate-agent-files.sh)"
    ],
    "ask": [
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(terraform init*)",
      "Bash(terraform plan*)",
      "Bash(scripts/deploy.sh*)",
      "Bash(./scripts/deploy.sh*)",
      "Bash(scripts/rollback.sh*)",
      "Bash(./scripts/rollback.sh*)",
      "Bash(scripts/run-bounded-pipeline.sh*)",
      "Bash(./scripts/run-bounded-pipeline.sh*)",
      "Bash(aws emr modify-instance-groups*)",
      "Bash(aws emr modify-instance-fleet*)",
      "Bash(aws emr put-managed-scaling-policy*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.envrc)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(~/.aws/credentials)",
      "Read(~/.aws/sso/cache/**)",
      "Read(~/.ssh/id_*)",
      "Read(**/secrets/**)",
      "Read(**/.secrets/**)",
      "Bash(terraform apply*)",
      "Bash(terraform destroy*)",
      "Bash(terraform -chdir=* apply*)",
      "Bash(terraform -chdir=* destroy*)",
      "Bash(tofu apply*)",
      "Bash(tofu destroy*)",
      "Bash(terragrunt apply*)",
      "Bash(terragrunt destroy*)",
      "Bash(terragrunt run-all apply*)",
      "Bash(terragrunt run-all destroy*)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push --force-with-lease*)",
      "Bash(git push * --force-with-lease*)",
      "Bash(git push * +*)",
      "Bash(aws s3 rm * --recursive*)",
      "Bash(aws s3 rm --recursive*)",
      "Bash(aws s3 rb*)",
      "Bash(aws s3api delete-bucket*)",
      "Bash(aws dynamodb delete-table*)",
      "Bash(aws neptune delete-db-cluster*)",
      "Bash(aws neptune delete-db-instance*)",
      "Bash(aws s3vectors delete-vector-bucket*)",
      "Bash(aws s3vectors delete-index*)",
      "Bash(aws s3vectors delete-vectors*)",
      "Bash(aws ecr delete-repository*)",
      "Bash(aws ecr batch-delete-image*)",
      "Bash(aws kms schedule-key-deletion*)",
      "Bash(aws kms disable-key*)",
      "Bash(aws emr terminate-clusters*)",
      "Bash(aws iam delete-*)",
      "Bash(aws iam detach-*)",
      "Bash(aws * delete-*)",
      "Bash(aws * terminate-*)",
      "Bash(aws secretsmanager get-secret-value*)",
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(mkfs*)",
      "Bash(dd * of=/dev/*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-dangerous.sh",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-dangerous.sh",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-writes.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-scala.sh",
            "timeout": 180
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/verify-tests-ran.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/verify-tests-ran.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
