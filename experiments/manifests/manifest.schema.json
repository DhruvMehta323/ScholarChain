{
  "$comment": "Executable schema (subset of JSON Schema, run by experiments/common/jsonschema_lite.py). Manifests are JSON, not YAML: scripts/run-experiment.sh reads experiments/manifests/<id>.json with jq. Extra cross-field rules live in experiments/validate_manifests.py.",
  "type": "object",
  "required": ["schema_version", "id", "letter", "title", "purpose", "approved", "approved_by", "command", "max_runtime_seconds",
               "duration_cap_seconds", "cost_cap_usd", "commit_sha", "dataset_snapshot", "scale", "resource_limits", "seed",
               "environment", "metrics_to_collect", "metric_locations", "stop_conditions", "requires", "reproduction"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$", "minLength": 3},
    "letter": {"enum": ["A", "B", "C", "D", "E", "F"]},
    "title": {"type": "string", "minLength": 3},
    "purpose": {"type": "string", "minLength": 10},
    "approved": {"type": "boolean"},
    "approved_by": {"type": "string"},
    "approval_ref": {"type": "string"},
    "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "command_notes": {"type": "array", "items": {"type": "string"}},
    "max_runtime_seconds": {"type": "integer", "minimum": 1, "maximum": 14400},
    "duration_cap_seconds": {"type": "integer", "minimum": 1, "maximum": 14400},
    "cost_cap_usd": {"type": "number", "exclusiveMinimum": 0, "maximum": 25},
    "model_cost_cap_usd": {"type": "number", "minimum": 0, "maximum": 2},
    "cost_estimate": {"type": "object"},
    "commit_sha": {"type": "string", "pattern": "^(FILL_AT_RUN_TIME|[0-9a-f]{40})$"},
    "dataset_snapshot": {
      "type": "object",
      "required": ["id", "manifest_entry"],
      "properties": {"id": {"type": "string", "minLength": 1}, "manifest_entry": {"type": "string", "minLength": 1},
                     "works": {"type": "integer", "minimum": 0}, "notes": {"type": "string"}}
    },
    "scale": {"type": "object", "required": ["label"], "properties": {"label": {"type": "string", "minLength": 1}}},
    "resource_limits": {
      "type": "object",
      "properties": {
        "emr_max_nodes": {"type": "integer", "minimum": 0, "maximum": 3},
        "emr_instance_type": {"enum": ["m5.xlarge"]},
        "ecs_max_tasks_per_service": {"type": "integer", "minimum": 0, "maximum": 4},
        "neptune_max_ncu": {"type": "number", "minimum": 0, "maximum": 2.5},
        "max_requests": {"type": "integer", "minimum": 0},
        "max_model_calls": {"type": "integer", "minimum": 0},
        "max_concurrency": {"type": "integer", "minimum": 0, "maximum": 20},
        "max_queue_messages": {"type": "integer", "minimum": 0, "maximum": 10000}
      }
    },
    "seed": {"type": "integer"},
    "environment": {
      "type": "object",
      "required": ["region", "approved_environments"],
      "properties": {"region": {"const": "us-east-2"}, "approved_environments": {"type": "array", "minItems": 1, "items": {"enum": ["course"]}}}
    },
    "metrics_to_collect": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
    "metric_locations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "stop_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
    "requires": {
      "type": "object",
      "required": ["prior_runs", "human_approval_flags"],
      "properties": {
        "prior_runs": {"type": "array", "items": {"type": "object", "required": ["experiment_id", "record_glob", "status"],
                                                   "properties": {"experiment_id": {"type": "string"}, "record_glob": {"type": "string"}, "status": {"const": "succeeded"}}}},
        "human_approval_flags": {"type": "array", "items": {"type": "string"}},
        "explicit_human_approval_required": {"type": "boolean"}
      }
    },
    "loadgen": {
      "type": "object",
      "required": ["max_requests_per_run", "max_model_calls_per_run", "max_duration_seconds", "max_concurrency", "levels", "model_cost_cap_usd"],
      "properties": {
        "max_requests_per_run": {"type": "integer", "minimum": 1},
        "max_model_calls_per_run": {"type": "integer", "minimum": 0},
        "max_duration_seconds": {"type": "integer", "minimum": 1, "maximum": 14400},
        "max_concurrency": {"type": "integer", "minimum": 1, "maximum": 20},
        "model_cost_cap_usd": {"type": "number", "minimum": 0, "maximum": 2},
        "request_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 300},
        "ramp_seconds": {"type": "number", "minimum": 0},
        "mode": {"enum": ["fused", "graph-only", "vector-only"]},
        "modes": {"type": "array", "items": {"enum": ["fused", "graph-only", "vector-only"]}},
        "question_limit": {"type": "integer", "minimum": 1},
        "levels": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["concurrency", "requests"],
                   "properties": {"concurrency": {"type": "integer", "minimum": 1, "maximum": 20}, "requests": {"type": "integer", "minimum": 1},
                                  "duration_seconds": {"type": "integer", "minimum": 1}, "mode": {"enum": ["fused", "graph-only", "vector-only"]}}}},
        "benchmark": {"type": "object"}
      }
    },
    "reproduction": {"type": "string", "minLength": 10}
  }
}
